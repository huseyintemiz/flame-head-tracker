    "import subprocess\n",
    "\n",
    "url = \"https://www.youtube.com/watch?v=M6WSW4rjjsE\"\n",
    "output_path = \"video.mp4\"\n",
    "\n",
    "# Download video using yt-dlp\n",
    "subprocess.run([\n",
    "    \"yt-dlp\",\n",
    "    \"-f\", \"bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best\",\n",
    "    \"-o\", output_path,\n",
    "    url\n",
    "])"
   ]
